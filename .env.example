# Kopier til .env.local og fyll inn. Alt er valgfritt: uten nøkler kjører appen i demomodus.

# Spør Hylla og SAM 3.1 bruker Metas API (Muse Spark og SAM). Samme nøkkel til begge.
# META_API_KEY=
# Velg språkmodell for Spør Hylla: meta | claude (standard: meta hvis META_API_KEY finnes, så claude, ellers demosvar)
# HYLLA_LLM=
# HYLLA_META_MODELL=muse-spark-1.3
# Tenking: minimal (raskest) | low | medium | high
# HYLLA_META_TENKING=minimal

# Telling og tekstsvar med Claude (reserve, eller hvis HYLLA_LLM=claude)
ANTHROPIC_API_KEY=
# HYLLA_MODELL=claude-opus-5-5
# Velg teller: sam3 | claude | yolo | demo (standard: sam3 hvis SAM3_URL finnes, så claude, ellers demo)
# HYLLA_TELLER=

# SAM 3-tjenesten i sam3/ (se sam3/README.md)
# SAM3_URL=http://localhost:8001

# YOLO-tjenesten i yolo/ (valgfri)
# YOLO_URL=http://localhost:8000

# Stemme med ElevenLabs Agents (se docs/elevenlabs.md)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Hemmelighet ElevenLabs sender i headeren x-hylla-secret til /api/verktoy/*
HYLLA_WEBHOOK_SECRET=

# Lagring i Supabase (se supabase/schema.sql). Uten dette ligger data i minnet.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# HYLLA_LAGER_ID=nydalen
# Start en ny database tom i stedet for med demodata (eller trykk «Tøm lageret» i Innstillinger)
# HYLLA_START=tom
